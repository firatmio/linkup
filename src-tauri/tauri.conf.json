{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LinkUp",
  "version": "0.1.0",
  "identifier": "com.quacomes.linkup",
  "build": {
    "beforeDevCommand": "node scripts/dev-vite.mjs",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LinkUp",
        "width": 1180,
        "height": 760,
        "minWidth": 880,
        "minHeight": 560,
        "resizable": true,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/firatmio/linkup/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE5N0I4QTRCMEMyREJBOTUKUldTVnVpME1TNHA3cWFNSjFOR1U2UkF5QlUwTmk3a05TdWc0VHlYTGlYT3lsTEk1QkJLYytHcFYK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
